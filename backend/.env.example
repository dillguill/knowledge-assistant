# Local development environment. Copy to `backend/.env` and fill in.
#
#   cp backend/.env.example backend/.env
#
# `backend/.env` is gitignored and holds live secrets — never commit it, and
# never paste its contents into an issue, PR, or chat.
#
# Real environment variables take precedence over this file, so an occasional
# `OWNER_TOKEN=... uv run ...` still overrides it. The deployed Space sets real
# env vars and ships no .env at all, so nothing here affects production.
# The test suite ignores this file entirely (see backend/conftest.py).

# --- Secrets -----------------------------------------------------------------

# https://openrouter.ai/keys — required for chat and every skill run.
OPENROUTER_API_KEY=

# https://firecrawl.dev — required for web search, fetch_url, and site_map.
# Free tier: 1000 credits/month, 10 search requests/minute.
FIRECRAWL_API_KEY=

# Any long random string. Gates uploads, wiki writes, web search, and skills.
# Locally this can be anything; it does NOT need to match the deployed Space.
OWNER_TOKEN=

# --- Dataset sync — LEAVE BLANK FOR LOCAL DEVELOPMENT ------------------------
#
# Setting both of these turns on Hugging Face dataset sync, which is NOT what
# you want on a dev machine:
#   * `sync.pull()` runs at startup and OVERWRITES backend/data/knowledge.db
#     with the production snapshot.
#   * `sync.schedule_push()` runs after writes and PUSHES your local database
#     back over production.
# The single-writer invariant assumes exactly one instance is syncing. Leave
# both empty and local runs stay entirely local.
HF_TOKEN=
HF_DATASET_REPO=

# --- Optional overrides (defaults in app/config.py are fine) -----------------

# DEFAULT_MODEL=google/gemma-4-26b-a4b-it:free
# DATA_DIR=data
# ALLOWED_ORIGINS=https://dillguill.github.io,http://localhost:5173

# Grounding budgets
# CONTEXT_CHAR_BUDGET=24000
# WEB_SEARCH_CHAR_BUDGET=12000
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_CACHE_TTL_S=3600

# Skill run budget. The ceiling exists because the OpenRouter free allowance is
# 20 requests/minute and 50/day, shared with chat. Lower these to burn less per
# run while testing.
# SKILL_MAX_MODEL_CALLS=12
# SKILL_MAX_SECTIONS=4
# SKILL_CONTRACT_RETRIES=2
# SKILL_AGENT_MAX_ITERATIONS=6
